# Copy to .env and fill in values for local development
POSTGRES_PASSWORD=localdev
SECRET_KEY=change-me-in-production

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Plaid (get from dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Linode Object Storage — endpoint without https:// prefix, with or without bucket prefix
LINODE_OBJ_ACCESS_KEY=
LINODE_OBJ_SECRET_KEY=
LINODE_OBJ_BUCKET=flowmint
LINODE_OBJ_ENDPOINT=us-southeast-1.linodeobjects.com
